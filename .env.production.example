# Copy this file to `.env` inside the deploy directory on the VPS
# (e.g. ~/cinemaseat/.env) and fill in the real values.
# Only used with docker-compose.prod.yml — see DEPLOYMENT.md.

# --- Domains (point these at the VPS in DNS first) ---
DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com

# --- Backend ---
DATABASE_URL=postgresql://user:password@host:5432/postgres?connection_limit=10&pool_timeout=30
HOLD_TTL_SECONDS=180
# How long a seat stays reserved once the user reaches Stripe Checkout.
# Much longer than HOLD_TTL_SECONDS on purpose: 3 minutes is the
# browse-and-decide window, not the time it takes to type card details.
PAYMENT_WINDOW_SECONDS=900
BETTER_AUTH_SECRET=
GATEWAY_SECRET=z2p-2026-secret
TRUSTED_ORIGINS=https://app.yourdomain.com

# Stripe (live keys here, not test keys) — see
# https://dashboard.stripe.com/apikeys and
# https://dashboard.stripe.com/webhooks (point the webhook endpoint at
# https://api.yourdomain.com/payments/stripe/webhook).
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=usd
FRONTEND_URL=https://app.yourdomain.com

# --- Frontend ---
# Must match the GitHub Actions `NEXT_PUBLIC_API_BASE_URL` variable — it's
# baked into the image at build time, this copy is just for the container's
# runtime env (kept in sync so both agree).
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com
