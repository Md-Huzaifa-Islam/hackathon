NODE_ENV=development
PORT=4000

# External Postgres (Supabase/Neon/RDS/etc.) — no in-compose postgres
# service. For local dev outside Docker, point this at your provider's
# connection string (or a local Postgres you run yourself).
DATABASE_URL=postgresql://user:password@host:5432/postgres
REDIS_URL=redis://redis:6379

HOLD_TTL_SECONDS=180
# How long a seat stays reserved once the user reaches Stripe Checkout.
# Much longer than HOLD_TTL_SECONDS on purpose: 3 minutes is the
# browse-and-decide window, not the time it takes to type card details.
PAYMENT_WINDOW_SECONDS=900

GATEWAY_URL=http://gateway:9000
CALLBACK_BASE_URL=http://backend:4000

BETTER_AUTH_SECRET=change-me-in-production
GATEWAY_SECRET=z2p-2026-secret
TRUSTED_ORIGINS=http://localhost:3000

# Stripe is the real payment provider (mock gateway is OTP-only now).
# Get these from https://dashboard.stripe.com/test/apikeys and
# https://dashboard.stripe.com/test/webhooks (or `stripe listen` locally).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional — lowercase ISO 4217 code; defaults to usd (BDT isn't a
# supported Stripe settlement currency on most accounts).
STRIPE_CURRENCY=usd
# Where Stripe Checkout redirects the browser back to — the frontend's
# public URL, not this API's.
FRONTEND_URL=http://localhost:3000
