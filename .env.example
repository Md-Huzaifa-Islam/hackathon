# Root-level env for `docker compose up`. Copy to .env before running.
# This is the ONLY .env you need for the Docker workflow — docker-compose.yml
# reads exclusively from this file and injects every value into the
# containers itself. backend/.env.example and frontend/.env.example exist
# only as a reference for running either app directly with `npm run dev`
# outside Docker; they are not read by docker compose.

# --- Backend ---
# External Postgres — Supabase, Neon, RDS, etc. There is no in-compose
# postgres service; this must point at a real reachable database. If your
# provider has a connection pooler, use it (e.g. Supabase's Session or
# Transaction pooler on port 5432/6543) — both for IPv4 reachability from
# Docker (some providers' direct-connection hostnames are IPv6-only, which
# containers on many hosts can't route) and because a hackathon rush is
# exactly the kind of connection burst poolers exist for.
#
# Append ?connection_limit=N&pool_timeout=30 to cap how many physical
# connections Prisma itself opens. Without it, Prisma's default pool size
# can exceed what a free-tier pooler allows under a real burst (Milestone 4
# Scenario A's 100 concurrent holds) — requests then fail with a P1001
# "can't reach database server" instead of a clean 409, which is a real
# correctness problem under exactly the load pattern judges test. Capping it
# makes Prisma queue excess requests instead (slower under a burst, but
# still correct — verified: 100 concurrent holds against Supabase's session
# pooler with connection_limit=10 still yields exactly one success and 99
# clean 409s, just ~25s instead of ~1s). Tune N to your provider's actual
# pool size.
DATABASE_URL=postgresql://user:password@host:5432/postgres?connection_limit=10&pool_timeout=30
HOLD_TTL_SECONDS=60
BETTER_AUTH_SECRET=change-me-in-production
# Must match the mock gateway's own GATEWAY_SECRET (its default is
# z2p-2026-secret) — verifies the X-Signature header on /payments/callback.
# Only override if you've also changed the gateway's GATEWAY_SECRET.
GATEWAY_SECRET=z2p-2026-secret
# better-auth's allowed origins for the browser session — the FRONTEND's own
# URL (where the browser loads the app from), not the backend's. Must match
# wherever NEXT_PUBLIC_API_BASE_URL's browser actually is. Comma-separated
# for more than one (e.g. local + deployed).
TRUSTED_ORIGINS=http://localhost:3000

# --- Frontend ---
# Must be reachable from the browser (not a Docker service name).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Production only (docker-compose.prod.yml) ---
# Don't set these here — they belong in the VPS's own .env, not your local
# one. Use .env.production.example as the template for that file, and see
# DEPLOYMENT.md for the full walkthrough.
