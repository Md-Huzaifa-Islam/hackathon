# Root-level env for `docker compose up`. Copy to .env before running.
# Individual service defaults live in backend/.env.example and frontend/.env.example
# for running each service outside Docker.

# --- Backend ---
# External Postgres — Supabase, Neon, RDS, etc. There is no in-compose
# postgres service; this must point at a real reachable database. Use the
# connection-pooler URL if your provider has one (e.g. Supabase's pgbouncer
# URI on port 6543) since a hackathon rush is exactly the kind of connection
# burst poolers exist for.
DATABASE_URL=postgresql://user:password@host:5432/postgres
HOLD_TTL_SECONDS=60
BETTER_AUTH_SECRET=change-me-in-production

# --- Frontend ---
# Must be reachable from the browser (not a Docker service name).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
